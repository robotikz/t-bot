{
  "hosting": {
    "public": "apps/web/dist/web/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/market-data/**",
        "run": {
          "serviceId": "api",
          "region": "europe-west2"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "bybit-market-scanner",
          "region": "europe-west2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
