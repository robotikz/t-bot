generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  NEW
  FILLED
  CANCELLED
  REJECTED
}

enum Timeframe {
  M1
  M5
  M15
  H1
  H4
  D1
}

enum ExchangeName {
  BINANCE
  BYBIT
  OKX
}

model Exchange {
  id        String    @id @default(cuid())
  name      ExchangeName @unique
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())

  orders    Order[]
  trades    Trade[]
}

model Strategy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Candle {
  id        String    @id @default(cuid())
  brokerId  String
  symbol    String
  timeframe Timeframe
  openTime  DateTime
  closeTime DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([brokerId, symbol, timeframe, openTime])
  @@index([brokerId, symbol, timeframe, closeTime])
}

model Order {
  id         String      @id @default(cuid())
  exchange   Exchange    @relation(fields: [exchangeId], references: [id])
  exchangeId String
  symbol     String
  side       OrderSide
  type       String
  quantity   Float
  price      Float?
  status     OrderStatus
  createdAt  DateTime    @default(now())

  trades     Trade[]
}

model Trade {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  exchange   Exchange @relation(fields: [exchangeId], references: [id])
  exchangeId String
  symbol     String
  price      Float
  quantity   Float
  fee        Float
  executedAt DateTime
}

model SignalObservation {
  id            String   @id @default(cuid())
  symbol        String
  sourceSymbol  String
  targetSymbol  String
  observedAt    DateTime @default(now())
  previousState String?
  currentState  String
  confidence    Float?
  risk          String?
  setupSnapshot Json
  aiDecision    String?
  reasons       Json
  rejections    Json
  usdcAvailable Boolean
  pairValidation Json
  currentPrice  Float
  timeframeInfo Json

  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([observedAt])
}

model SignalTransition {
  id            String   @id @default(cuid())
  symbol        String
  fromState     String?
  toState       String
  observedAt    DateTime @default(now())
  observationId String

  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([observedAt])
}
